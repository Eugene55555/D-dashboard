# Переменные окружения (скопируйте в .env и заполните)
# Пароль на вход. Пусто = без пароля (только для локальной сети).
J_PASSWORD=

# Секрет для подписи cookie сессии. Сгенерируйте: openssl rand -hex 32
J_SECRET=

# Аккаунт (подписи в интерфейсе)
# Кабинет по умолчанию (id из data/accounts.json) и подписи,
# если accounts.json не используется.
J_ACCOUNT=dimon
J_ACCOUNT_NAME="Dimon · Amazon Ads US"
J_PROFILE_ID=1794615056359259
J_CURRENCY=USD
J_TZ=America/Los_Angeles

# Пути (J_DB — только для режима без accounts.json)
J_DB=data/dashboard.db
J_ACCOUNTS=data/accounts.json
J_INBOX=data/inbox
J_INBOX_ROOT=data

# true — cookie только по https (включайте на публичном домене)
J_SECURE_COOKIE=false
